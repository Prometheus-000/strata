        "accent-soft": {
          "$value": "oklch(0.300 0.000 250.0 / 0.12)",
          "$type": "color",
          "$extensions": {
            "strata.ledger": {
              "status": "kept",
              "decided": {
                "kind": "human",
                "actor": "prometheus-000"
              },
              "written": {
                "kind": "agent",
                "actor": "claude-code"
              },
              "reason": "The wash is the hover on ghost actions and the selection tint — Visionary’s --sel. It is the accent’s only appearance on a surface.",
              "collapsesTo": "transparent"
            }
          }
        },
        "accent-line": {
          "$value": "oklch(0.300 0.000 250.0 / 0.40)",
          "$type": "color",
          "$extensions": {
            "strata.ledger": {
