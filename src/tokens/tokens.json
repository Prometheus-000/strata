              },
              "written": {
                "kind": "agent",
                "actor": "claude-code"
              },
              "reason": "The one hover step a filled action gets. Cutting it left a primary button that answered a hover with nothing at all, which reads as a dead control.",
              "collapsesTo": "--accent"
